# Rig's own data when you run it on this repo.
.proving-ground/
# Except the tutorial example's tasks: they ship with the engine (only its scenarios, never a run).
!/engine/src/proving_ground/tutorial/project/.proving-ground/
/engine/src/proving_ground/tutorial/project/.proving-ground/*
!/engine/src/proving_ground/tutorial/project/.proving-ground/scenarios/
# The same for the repo tutorial's (fewer tokens) example.
!/engine/src/proving_ground/tutorial/tokens/project/.proving-ground/
/engine/src/proving_ground/tutorial/tokens/project/.proving-ground/*
!/engine/src/proving_ground/tutorial/tokens/project/.proving-ground/scenarios/
